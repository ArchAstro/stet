class Md < Formula
  desc "Minimal, fast markdown writer with vim keys and review suggestions"
  homepage "https://github.com/ArchAstro/md"
  version "__VERSION__"
  license "MIT"

  livecheck do
    url :stable
    regex(/^v?(\d+(?:\.\d+)+)$/i)
  end

  on_macos do
    on_arm do
      url "https://github.com/ArchAstro/md/releases/download/v__VERSION__/md-darwin-arm64.tar.gz"
      sha256 "__SHA_DARWIN_ARM64__"
    end
    on_intel do
      url "https://github.com/ArchAstro/md/releases/download/v__VERSION__/md-darwin-x64.tar.gz"
      sha256 "__SHA_DARWIN_X64__"
    end
  end

  on_linux do
    on_intel do
      url "https://github.com/ArchAstro/md/releases/download/v__VERSION__/md-linux-x64.tar.gz"
      sha256 "__SHA_LINUX_X64__"
    end
  end

  def install
    bin.install "md"
    pkgshare.install "skill"
  end

  def caveats
    <<~EOS
      To let Claude Code work in your documents, link the skill:
        ln -s #{opt_pkgshare}/skill/md ~/.claude/skills/md
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/md --version")
  end
end
